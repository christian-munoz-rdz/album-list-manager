# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/listen_later

# Session
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Spotify Web API (client credentials — search + album metadata, no user login)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=US
SPOTIFY_SEARCH_LIMIT=10

# Optional: user OAuth access token — needed to seed private playlists (playlist-read-private).
# Get a token from Spotify Web API docs "Try it" / Web Console for Get Playlist Items.
SPOTIFY_USER_ACCESS_TOKEN=

# Last.fm API
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# App URLs
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
